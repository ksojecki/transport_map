{
  "name": "mapa-transportu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node ./node_modules/typescript6/bin/tsc -p tsconfig.json",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src tests app.js",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/unzipper": "0.10.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript6": "npm:typescript@6.0.3",
    "typescript7": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
